{%- comment -%}
  Product payload for the gift-guide popup and the bundle companion.
  Accepts:
    product {product}
    compact {boolean} omit the description when only variant data is needed
{%- endcomment -%}
{%- if product == blank -%}
  null
{%- else -%}
  {
    "id": {{ product.id | json }},
    "title": {{ product.title | json }},
    "handle": {{ product.handle | json }},
    "description": {% if compact %}""{% else %}{{ product.description | json }}{% endif %},
    "available": {{ product.available | json }},
    "price": {{ product.price | json }},
    "featured_image": {%- if product.featured_image -%}{{ product.featured_image | image_url: width: 1400 | json }}{%- else -%}null{%- endif -%},
    "options": [
      {%- for option in product.options_with_values -%}
        {
          "name": {{ option.name | json }},
          "position": {{ option.position | json }},
          "values": [
            {%- for value in option.values -%}
              {{ value.name | default: value | json }}{%- unless forloop.last -%},{%- endunless -%}
            {%- endfor -%}
          ]
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ],
    "variants": [
      {%- for variant in product.variants -%}
        {
          "id": {{ variant.id | json }},
          "available": {{ variant.available | json }},
          "price": {{ variant.price | json }},
          "compare_at_price": {{ variant.compare_at_price | json }},
          "options": [
            {%- if variant.option1 != blank -%}{{ variant.option1 | json }}{%- endif -%}
            {%- if variant.option2 != blank -%},{{ variant.option2 | json }}{%- endif -%}
            {%- if variant.option3 != blank -%},{{ variant.option3 | json }}{%- endif -%}
          ],
          "inventory_management": {{ variant.inventory_management | json }},
          "inventory_policy": {{ variant.inventory_policy | json }},
          "inventory_quantity": {{ variant.inventory_quantity | json }},
          "quantity_rule": {
            "min": {{ variant.quantity_rule.min | default: 1 }},
            "max": {% if variant.quantity_rule.max %}{{ variant.quantity_rule.max }}{% else %}null{% endif %},
            "increment": {{ variant.quantity_rule.increment | default: 1 }}
          },
          "featured_image": {%- if variant.featured_image -%}{{ variant.featured_image | image_url: width: 1400 | json }}{%- elsif variant.featured_media.preview_image -%}{{ variant.featured_media.preview_image | image_url: width: 1400 | json }}{%- else -%}null{%- endif -%}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
{%- endif -%}
